# Frontend public configuration. Copy to .env.local for a new local setup.
# Every NEXT_PUBLIC variable is browser-visible; never put secrets here.
NEXT_PUBLIC_API_URL="http://localhost:3001"
# Optional override for browser-held company owner signing; defaults to this testnet RPC.
NEXT_PUBLIC_NEAR_RPC_URL="https://test.rpc.fastnear.com"
# Current payer wallets use NEAR Wallet Selector (MyNearWallet / Meteor).
# No EVM WalletConnect project id is required by this integration.
