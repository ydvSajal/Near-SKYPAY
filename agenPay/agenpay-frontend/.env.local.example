# Frontend environment (copy to .env.local)

# Backend API base URL
NEXT_PUBLIC_API_URL="http://localhost:3001"

# WalletConnect / Reown project id — required for WalletConnect + mobile wallets.
# Get one free at https://cloud.reown.com. Injected wallets (MetaMask,
# Coinbase extension) work without it, but WalletConnect will not.
NEXT_PUBLIC_WC_PROJECT_ID=""
