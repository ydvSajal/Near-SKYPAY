// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  password         String
  name             String?
  notionApiKey     String?
  notionWorkspaceId String?
  walletAddress    String?            // managed (Privy embedded) wallet — agent signs here
  walletId         String?
  externalWalletAddress String?       // self-custody wallet the user connected (MetaMask, etc.)
  walletProvider        String?       // metamask | walletConnect | coinbaseWallet | ...
  walletNonce           String?       // one-time nonce for connect-signature verification
  // --- NEAR (hackathon) ---
  nearAccountId    String?  @unique   // company receiving account (collections land here)
  nearPublicKey    String?            // owner's browser-held public key (private key never stored)
  vaultAccountId   String?  @unique   // operating vault contract
  agentAccountId   String?            // agent account allowed to call vault.pay only
  agentKeyEnc      String?            // agent function-call key, AES-GCM encrypted with NEAR_KEY_ENC_SECRET
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  // Relations
  notionDatabases  NotionDatabase[]
  transactions     Transaction[]
  agent            Agent?
  paymentRequests  PaymentRequest[]
  outgoingPayments OutgoingPayment[]
  invoices         Invoice[]
  payees           Payee[]
  paymentAttempts  PaymentAttempt[]
  outboxJobs       OutboxJob[]
  sponsorLedger    SponsorLedger[]
}

// ===================== NEAR / hackathon models =====================
// All money is an integer string in token base units (USDC on NEAR = 6 decimals). Never Float.

model Invoice {
  id             String    @id @default(cuid())
  userId         String
  number         String                      // human number e.g. INV-0001, unique per company
  customerEmail  String
  customerName   String?
  description    String?
  lineItems      Json                         // [{description, quantity, unitAmount(base units)}]
  amount         String                       // total, base units
  asset          String    @default("USDC")
  assetContract  String                       // pinned NEP-141 contract id
  decimals       Int       @default(6)
  network        String    @default("near:testnet")
  receiver       String                       // company NEAR account that must receive funds (snapshotted)
  dueDate        DateTime
  status         String    @default("pending") // pending | paid | refunded | cancelled
  settledAmount  String?
  settledTxHash  String?   @unique            // a tx can settle only one invoice
  settledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@unique([userId, number])
}

model Payee {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  nearAccount String                          // registered by the owner only; never taken from prompts/emails
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nearAccount])
}

model PaymentAttempt {
  id          String    @id @default(cuid())
  userId      String
  direction   String                           // IN (invoice) | OUT (vault payment)
  invoiceId   String?
  paymentId   String    @unique                // idempotency key; for OUT it is the vault payment_id
  requestHash String?                          // binds id to recipient/amount/ref
  recipient   String?
  amount      String
  asset       String    @default("USDC")
  network     String    @default("near:testnet")
  status      String    @default("authorized") // authorized|reserved|submitted|processing|settled|failed|unknown|refunded
  txHash      String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
}

model OutboxJob {
  id             String    @id @default(cuid())
  userId         String
  kind           String                        // receipt_email | notion_invoice
  idempotencyKey String    @unique
  payload        Json
  status         String    @default("pending") // pending | done | failed
  attempts       Int       @default(0)
  mode           String?                       // live | fixture (set when processed)
  lastError      String?
  runAfter       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SponsorLedger {
  id        String   @id @default(cuid())
  userId    String
  kind      String                             // account_create | storage_deposit | relay | agent_pay
  detail    String?
  txHash    String?
  yoctoCost String   @default("0")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id                   String    @id @default(cuid())
  userId               String    @unique
  name                 String
  status               String    @default("STOPPED")
  threadId             String?
  lastActivity         DateTime?
  totalProcessed       Int       @default(0)
  totalSent            Int       @default(0)
  totalReceived        Int       @default(0)
  totalAmountSent      Float     @default(0)
  totalAmountReceived  Float     @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Transaction {
  id                String    @id @default(cuid())
  userId            String
  type              String    // INCOMING, OUTGOING, REFUND
  status            String    // PENDING, PROCESSING, COMPLETED, FAILED
  amount            Float
  currency          String    @default("ETH")
  network           String?
  description       String?
  toAddress         String?
  fromAddress       String?
  txHash            String?
  x402PayId         String?
  relatedRequestId  String?
  paymentId         String?
  paymentLink       String?
  recipientEmail    String?
  emailSent         Boolean   @default(false)
  emailSentAt       DateTime?
  completedAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionDatabase {
  id           String   @id @default(cuid())
  userId       String
  databaseId   String   @unique
  databaseName String
  databaseType String
  properties   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PaymentRequest {
  id              String    @id
  userId          String
  amount          Float
  currency        String    @default("USDC")
  network         String    @default("sei-testnet")
  recipientEmail  String?
  recipientName   String?
  description     String?
  aiPrompt        String?
  transactionType String    @default("ask_payment") // ask_payment, ask_and_refund, subscription
  scheduleType    String    @default("immediate")   // immediate, scheduled
  scheduledDate   DateTime?
  status          String    @default("draft")       // draft, scheduled, processing, payment_received, refunded, failed, cancelled
  x402PayLink     String?
  paymentHash     String?
  paidAt          DateTime?
  refundDate      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  user            User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OutgoingPayment {
  id               String    @id @default(cuid())
  userId           String
  amount           Float
  currency         String    @default("SEI")
  network          String    @default("sei-testnet")
  recipientAddress String
  recipientName    String?
  fromName         String?
  description      String?
  scheduleDate     DateTime
  status           String    @default("scheduled") // scheduled, processing, completed, failed, cancelled
  txHash           String?
  executedAt       DateTime?
  relatedRequestId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin")
}

model SystemConfig {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  description  String?
  updatedAt    DateTime @updatedAt

  @@map("system_config")
} 