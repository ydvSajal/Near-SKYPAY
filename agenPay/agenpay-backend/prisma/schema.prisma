// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  password         String
  name             String?
  // --- business profile: printed on invoices (snapshotted per invoice) ---
  companyName      String?
  companyAddress   String?
  country          String?
  taxId            String?
  invoiceNotes     String?            // payment terms / footer shown on every invoice
  notionApiKey     String?
  notionWorkspaceId String?
  // --- NEAR (hackathon) ---
  nearAccountId    String?  @unique   // company receiving account (collections land here)
  nearPublicKey    String?            // owner's browser-held public key (private key never stored)
  vaultAccountId   String?  @unique   // operating vault contract
  agentAccountId   String?            // agent account allowed to call vault.pay only
  agentKeyEnc      String?            // agent function-call key, AES-GCM encrypted with NEAR_KEY_ENC_SECRET
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  
  // Relations
  notionDatabases  NotionDatabase[]
  agent            Agent?
  invoices         Invoice[]
  payees           Payee[]
  paymentAttempts  PaymentAttempt[]
  payoutBatches    PayoutBatch[]
  outboxJobs      OutboxJob[]
  sponsorLedger    SponsorLedger[]
}

// ===================== NEAR / hackathon models =====================
// All money is an integer string in token base units (USDC on NEAR = 6 decimals). Never Float.

model Invoice {
  id             String    @id @default(cuid())
  userId         String
  number         String                      // human number e.g. INV-0001, unique per company
  customerEmail  String
  customerName   String?
  description    String?
  lineItems      Json                         // [{description, quantity, unitAmount(base units)}]
  amount         String                       // total, base units
  asset          String    @default("USDC")
  assetContract  String                       // pinned NEP-141 contract id
  decimals       Int       @default(6)
  network        String    @default("near:testnet")
  seller         Json?                        // {name,address,country,taxId,email,notes} as issued; later profile edits do not rewrite old invoices
  receiver       String                       // company NEAR account that must receive funds (snapshotted)
  dueDate        DateTime
  status         String    @default("pending") // pending | paid | refunded | cancelled
  settledAmount  String?
  settledTxHash  String?   @unique            // a tx can settle only one invoice
  settledAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@unique([userId, number])
}

model Payee {
  id          String   @id @default(cuid())
  userId      String
  name        String
  email       String?
  nearAccount String                          // registered by the owner only; never taken from prompts/emails
  notes       String?
  kind        String   @default("supplier") // employee | supplier
  role        String?                       // job title, employees only
  salary      String?                       // default pay per payroll run, base units
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nearAccount])
}

model PaymentAttempt {
  id          String    @id @default(cuid())
  userId      String
  direction   String                           // IN (invoice) | OUT (vault payment)
  invoiceId   String?
  paymentId   String    @unique                // idempotency key; for OUT it is the vault payment_id
  requestHash String?                          // binds id to recipient/amount/ref
  batchId     String?                          // set when paid as part of a payout batch
  memo        String?
  recipient   String?
  amount      String
  asset       String    @default("USDC")
  network     String    @default("near:testnet")
  status      String    @default("authorized") // authorized|reserved|submitted|processing|settled|failed|unknown|refunded
  txHash      String?
  error       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoice Invoice? @relation(fields: [invoiceId], references: [id])
  batch   PayoutBatch? @relation(fields: [batchId], references: [id])
}

model PayoutBatch {
  id        String   @id @default(cuid())
  userId    String
  label     String
  status    String   @default("queued")        // queued | done | partial | failed
  total     String                              // base units, sum of all items
  source    String?                             // uploaded file name, when imported from a spreadsheet
  kind      String   @default("payout")         // payroll | payout
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments  PaymentAttempt[]
}

model OutboxJob {
  id             String    @id @default(cuid())
  userId         String
  kind           String                        // receipt_email | notion_invoice
  idempotencyKey String    @unique
  payload        Json
  status         String    @default("pending") // pending | done | failed
  attempts       Int       @default(0)
  mode           String?                       // live | fixture (set when processed)
  lastError      String?
  runAfter       DateTime  @default(now())
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SponsorLedger {
  id        String   @id @default(cuid())
  userId    String
  kind      String                             // account_create | storage_deposit | relay | agent_pay
  detail    String?
  txHash    String?
  yoctoCost String   @default("0")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id                   String    @id @default(cuid())
  userId               String    @unique
  name                 String
  status               String    @default("STOPPED")
  threadId             String?
  lastActivity         DateTime?
  totalProcessed       Int       @default(0)
  totalSent            Int       @default(0)
  totalReceived        Int       @default(0)
  totalAmountSent      Float     @default(0)
  totalAmountReceived  Float     @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model NotionDatabase {
  id           String   @id @default(cuid())
  userId       String
  databaseId   String   @unique
  databaseName String
  databaseType String
  properties   String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  createdAt DateTime @default(now())

  @@map("admin")
}

model SystemConfig {
  id           String   @id @default(cuid())
  key          String   @unique
  value        String
  description  String?
  updatedAt    DateTime @updatedAt

  @@map("system_config")
} 