# AgenPay Backend Environment Variables
# Copy this file to .env and fill in your actual values

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/agenpay"

# JWT Secret (generate a secure random string)
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Admin portal seed credentials (used by: npm run admin:seed). Never committed.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"

# Privy Wallet Integration - Required for wallet operations
# Get these from https://console.privy.io/
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"

# Notion API Integration - Required for workspace automation
# Get from https://www.notion.so/my-integrations
NOTION_CLIENT_ID="your_notion_client_id"
NOTION_CLIENT_SECRET="your_notion_client_secret"
NOTION_REDIRECT_URI="http://localhost:3000/auth/notion-callback"

# Privy Wallet Integration
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"

# OKX DEX Integration
OKX_API_KEY="your_okx_api_key"
OKX_SECRET_KEY="your_okx_secret_key"
OKX_PASSPHRASE="your_okx_passphrase"

# X402Pay Integration
X402_API_KEY="your_x402_api_key"
X402_WEBHOOK_SECRET="your_x402_webhook_secret"
X402_FACILITATOR_URL="http://localhost:3002"
X402_USE_MAINNET="false"
X402_NETWORK_OVERRIDE="sei-testnet"

# LangChain/LLM Configuration
# Primary Provider: MiniMax
MINIMAX_API_KEY="your-minimax-api-key"
MINIMAX_MODEL="minimax-m2.7"

# Secondary Provider: Google Gemini
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# Fallback Provider: OpenAI
OPENAI_API_KEY="your-openai-api-key"

# OpenRouter (OpenAI-compatible, one key for many models)
# Get from https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# AI Provider Selection (default: minimax)
AI_PROVIDER="minimax"  # Options: minimax, gemini, openai, openrouter

# Email Service (Optional - for sending payment notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"

# Server Configuration
PORT="3001"
NODE_ENV="development"

# Sei Network Configuration
DEFAULT_NETWORK="sei-testnet"
DEFAULT_CURRENCY="SEI"

# Security
BCRYPT_ROUNDS="12"
RATE_LIMIT_WINDOW_MS="900000"  # 15 minutes
RATE_LIMIT_MAX_REQUESTS="100"  # requests per window

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000" 