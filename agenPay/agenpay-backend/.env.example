# SkyPay backend. Copy to .env. NEAR secrets live in .env.near (see .env.near.example; `npm run near:bootstrap` writes it).

DATABASE_URL="postgresql://postgres:skypay@localhost:5434/skypay"
JWT_SECRET="generate-a-long-random-string"
FRONTEND_URL="http://localhost:3000"   # CORS + links in emails (comma-separated for several)
BASE_URL="http://localhost:3001"       # this backend's public URL (x402 pay links)

# Admin portal seed (npm run admin:seed)
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="change-me-min-8-chars"

# Notion (optional)
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""
NOTION_REDIRECT_URI="http://localhost:3001/api/notion/callback"

# Agent LLM (one is enough): gemini | openai | openrouter | minimax
AI_PROVIDER="gemini"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
MINIMAX_API_KEY=""

# Email (optional; without it the outbox runs in logged fixture mode)
EMAIL_SERVICE="gmail"
EMAIL_USER=""
EMAIL_PASS=""
EMAIL_FROM="SkyPay <noreply@example.com>"

PORT="3001"
NODE_ENV="development"
BCRYPT_ROUNDS="12"
RATE_LIMIT_WINDOW_MS="900000"
RATE_LIMIT_MAX_REQUESTS="6000"

# NEAR secrets: copy .env.near.example to .env.near, or run near:bootstrap on testnet.
# Optional mainnet routing previews only; never generates a deposit address.
ONECLICK_API_URL="https://1click.chaindefuser.com/v0"
ONECLICK_JWT=""
INTENTS_QUOTE_RECIPIENT="intents.near"
