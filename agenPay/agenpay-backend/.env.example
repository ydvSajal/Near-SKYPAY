# AgenPay Backend Environment Variables

# ============================================
# DATABASE (REQUIRED) â€” Postgres
# ============================================
DATABASE_URL="postgresql://username:password@localhost:5432/agenpay?schema=public"

# ============================================
# AUTHENTICATION (REQUIRED)
# ============================================
JWT_SECRET="your_jwt_secret_here"
JWT_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12

# ============================================
# AI AGENT (REQUIRED)
# ============================================
AI_PROVIDER="gemini"  # Options: minimax, gemini, openai, openrouter
OPENAI_API_KEY="your_openai_key_here"
OPENROUTER_API_KEY="your_openrouter_key_here"
OPENROUTER_MODEL="openai/gpt-4o-mini"
GEMINI_API_KEY="your_gemini_key_here"
# Optional alias for Google Cloud API key naming
# GOOGLE_API_KEY="your_google_cloud_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_FALLBACK_MODEL="gemini-1.5-flash"

# ============================================
# PRIVY WALLET INTEGRATION
# ============================================
PRIVY_APP_ID="your_privy_app_id"
PRIVY_APP_SECRET="your_privy_app_secret"

# ============================================
# NOTION INTEGRATION
# ============================================
NOTION_CLIENT_ID="your_notion_client_id"
NOTION_CLIENT_SECRET="your_notion_client_secret"
NOTION_REDIRECT_URI="http://localhost:3001/api/notion/callback"

# ============================================
# X402 FACILITATOR
# ============================================
X402_FACILITATOR_URL="http://localhost:3002"
X402_USE_MAINNET="false"
X402_NETWORK_OVERRIDE="sei-testnet"

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# ============================================
# SEI NETWORK
# ============================================
DEFAULT_NETWORK="sei-testnet"
DEFAULT_CURRENCY="SEI"

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=6000

# ============================================
# NEAR INTENTS 1CLICK (dry quotes only, optional)
# ============================================
# ONECLICK_API_URL=https://1click.chaindefuser.com/v0
# ONECLICK_JWT=                      # optional partner token; without it 1Click adds its unauthenticated fee
# INTENTS_QUOTE_RECIPIENT=intents.near   # mainnet account used to price quotes for testnet invoices
